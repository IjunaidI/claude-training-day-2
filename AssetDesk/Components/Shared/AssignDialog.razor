@if (Asset is not null)
{
    <div class="backdrop" @onclick="Cancel"></div>
    <div class="modal-wrap">
        <div class="modal">
            <h2 class="section-heading">Assign @Asset.Tag</h2>
            <p class="cell-muted">@Asset.Make @Asset.Model</p>

            <div class="field">
                <label>Employee</label>
                <select @bind="_employeeId">
                    <option value="">Select an employee</option>
                    @foreach (var e in Employees)
                    {
                        <option value="@e.Id">@e.Name — @e.Department</option>
                    }
                </select>
            </div>

            <div class="field">
                <label>Assignment date</label>
                <input type="date" value="@_assignedDate"
                       @onchange="e => _assignedDate = e.Value?.ToString() ?? string.Empty" />
            </div>

            <div class="modal-actions">
                <button type="button" class="btn" @onclick="Cancel">Cancel</button>
                <button type="button" class="btn btn-primary"
                        disabled="@(string.IsNullOrEmpty(_employeeId))"
                        @onclick="Confirm">
                    Assign asset
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Asset? Asset { get; set; }
    [Parameter] public List<Employee> Employees { get; set; } = [];
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<(string EmployeeId, string AssignedDate)> OnConfirm { get; set; }

    private string _employeeId = "";
    private string _assignedDate = Format.TodayIso();
    private string? _lastAssetId;

    protected override void OnParametersSet()
    {
        if (Asset?.Id != _lastAssetId)
        {
            _employeeId = "";
            _assignedDate = Format.TodayIso();
            _lastAssetId = Asset?.Id;
        }
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();

    private async Task Confirm()
    {
        if (string.IsNullOrEmpty(_employeeId))
        {
            return;
        }
        await OnConfirm.InvokeAsync((_employeeId, _assignedDate));
    }
}
