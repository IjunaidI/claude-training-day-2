@page "/"
@inject AssetRepository Repo

<PageTitle>AssetDesk</PageTitle>

<Sidebar ActiveTab="_activeTab" OnTabChange="SetTab" />

<div class="content">
    @switch (_activeTab)
    {
        case Sidebar.Tab.Dashboard:
            <Dashboard State="_state" OnCategoryClick="GoToAssetsWithCategory" />
            break;
        case Sidebar.Tab.Assets:
            <AssetsTable AssetList="_state.Assets"
                         Employees="_state.Employees"
                         InitialCategoryFilter="_categoryFilter"
                         ErrorMessage="@_errorMessage"
                         OnDismissError="() => _errorMessage = null"
                         OnAddAssetClick="() => _drawerOpen = true"
                         OnAssignClick="asset => _assigningAsset = asset"
                         OnReturnClick="HandleReturn"
                         OnSetStatusClick="HandleSetStatus" />
            break;
        case Sidebar.Tab.People:
            <People State="_state" OnReturnClick="HandleReturn" />
            break;
    }
</div>

<AddAssetDrawer IsOpen="_drawerOpen"
                ExistingAssets="_state.Assets"
                OnClose="() => _drawerOpen = false"
                OnCreated="Refresh" />

<AssignDialog Asset="_assigningAsset"
              Employees="_state.Employees"
              OnCancel="() => _assigningAsset = null"
              OnConfirm="HandleAssignConfirm" />

@code {
    private Sidebar.Tab _activeTab = Sidebar.Tab.Dashboard;
    private AppState _state = new([], []);
    private string? _errorMessage;
    private bool _drawerOpen;
    private Asset? _assigningAsset;
    private Category? _categoryFilter;

    protected override void OnInitialized()
    {
        _state = Repo.GetState();
    }

    private void SetTab(Sidebar.Tab tab)
    {
        _activeTab = tab;
        _categoryFilter = null;
    }

    private void GoToAssetsWithCategory(Category category)
    {
        _categoryFilter = category;
        _activeTab = Sidebar.Tab.Assets;
    }

    private void Refresh() => _state = Repo.GetState();

    private void HandleReturn(Asset asset)
    {
        try
        {
            Repo.Return(asset.Id);
            Refresh();
        }
        catch (AssetDeskException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void HandleSetStatus((Asset Asset, Status Status) request)
    {
        try
        {
            Repo.SetStatus(request.Asset.Id, request.Status);
            Refresh();
        }
        catch (AssetDeskException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void HandleAssignConfirm((string EmployeeId, string AssignedDate) request)
    {
        if (_assigningAsset is null)
        {
            return;
        }

        try
        {
            Repo.Assign(_assigningAsset.Id, request.EmployeeId, request.AssignedDate);
            Refresh();
        }
        catch (AssetDeskException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _assigningAsset = null;
        }
    }
}
