<div class="sidebar">
    <div class="wordmark">AssetDesk</div>
    <button class="tab-btn @(ActiveTab == "dashboard" ? "active" : "")" @onclick='() => OnTabChange.InvokeAsync("dashboard")'>
        Dashboard
    </button>
    <button class="tab-btn @(ActiveTab == "assets" ? "active" : "")" @onclick='() => OnTabChange.InvokeAsync("assets")'>
        Assets
    </button>
    <button class="tab-btn @(ActiveTab == "people" ? "active" : "")" @onclick='() => OnTabChange.InvokeAsync("people")'>
        People
    </button>
</div>

@code {
    [Parameter] public string ActiveTab { get; set; } = "dashboard";
    [Parameter] public EventCallback<string> OnTabChange { get; set; }
}
