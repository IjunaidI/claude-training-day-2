+    public List<AssetEvent> GetHistory(string assetId)
+    {
+        using var conn = Connect();
+
+        var exists = conn.ExecuteScalar<long>(
+            "SELECT COUNT(*) FROM assets WHERE id = @assetId", new { assetId });
+        if (exists == 0)
+            throw new AssetDeskException("That asset no longer exists. Refresh to see current data.");
+
+        return conn.Query<AssetEventRow>(
+                """
+                SELECT id, asset_id, type, from_status, to_status, employee_id, occurred_at
+                FROM asset_events
+                WHERE asset_id = @assetId
+                ORDER BY id DESC
+                """,
+                new { assetId })
+            .Select(MapAssetEvent)
+            .ToList();
+    }
+
+    // Runs on the mutation's own connection and transaction, after its statement, so a
+    // failed mutation rolls its event back with it. Statuses arrive as database strings.
+    private static void RecordEvent(SqliteConnection conn, SqliteTransaction tx, string assetId,
+        AssetEventType type, string? fromStatus, string toStatus, string? employeeId)
+    {
+        conn.Execute(
+            """
+            INSERT INTO asset_events (asset_id, type, from_status, to_status, employee_id, occurred_at)
+            VALUES (@assetId, @type, @fromStatus, @toStatus, @employeeId, @occurredAt)
+            """,
+            new
+            {
+                assetId,
+                type = Format.ToDb(type),
+                fromStatus,
+                toStatus,
+                employeeId,
+                occurredAt = DateTime.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture),
+            },
+            tx);
+    }
