diff --git a/Components/Shared/HistoryDialog.razor b/Components/Shared/HistoryDialog.razor
new file mode 100644
index 0000000..0cfed94
--- /dev/null
+++ b/Components/Shared/HistoryDialog.razor
@@ -0,0 +1,82 @@
+<div class="backdrop" @onclick="Close"></div>
+<div class="modal">
+    <h2>History</h2>
+    <p><span class="mono">@Asset.Tag</span> — @Asset.Make @Asset.Model</p>
+
+    @if (_error is not null)
+    {
+        <div class="field-error">@_error</div>
+    }
+    else if (_events is null)
+    {
+        <p class="muted">Loading…</p>
+    }
+    else if (_events.Count == 0)
+    {
+        <p class="muted">No history recorded yet.</p>
+    }
+    else
+    {
+        <div class="history">
+            <table class="table">
+                <thead>
+                    <tr>
+                        <th>When</th>
+                        <th>Event</th>
+                    </tr>
+                </thead>
+                <tbody>
+                    @foreach (var e in _events)
+                    {
+                        <tr>
+                            <td class="mono">@Format.EventTime(e.OccurredAt)</td>
+                            <td>@Describe(e)</td>
+                        </tr>
+                    }
+                </tbody>
+            </table>
+        </div>
+    }
+
+    <div class="form-actions">
+        <button type="button" class="btn" @onclick="Close">Close</button>
+    </div>
+</div>
+
+@code {
+    [Parameter, EditorRequired] public AssetDto Asset { get; set; } = null!;
+    [Parameter] public List<EmployeeDto> Employees { get; set; } = [];
+    [Parameter] public EventCallback OnClose { get; set; }
+    [Parameter] public CancellationToken Ct { get; set; }
+
+    [Inject] private AssetDeskClient Client { get; set; } = default!;
+
+    private List<AssetEventDto>? _events;
+    private string? _error;
+
+    protected override async Task OnInitializedAsync()
+    {
+        try
+        {
+            _events = await Client.GetHistoryAsync(Asset.Id, Ct);
+        }
+        catch (AssetDeskException ex)
+        {
+            _error = ex.Message;
+        }
+    }
+
+    private Task Close() => OnClose.InvokeAsync();
+
+    private string Describe(AssetEventDto e) => e.Type switch
+    {
+        AssetEventType.Assigned => $"Assigned to {EmployeeName(e.EmployeeId)}",
+        AssetEventType.Returned when e.EmployeeId is not null => $"Returned by {EmployeeName(e.EmployeeId)}",
+        AssetEventType.StatusChanged when e.FromStatus is { } from =>
+            $"{Format.Label(from)} → {Format.Label(e.ToStatus)}",
+        _ => Format.Label(e.Type),
+    };
+
+    private string EmployeeName(string? employeeId) =>
+        Employees.FirstOrDefault(emp => emp.Id == employeeId)?.Name ?? "—";
+}
